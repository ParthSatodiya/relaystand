# --- Database -----------------------------------------------------------
# Local dev keeps the file next to the schema. In Docker this is overridden to
# point at the mounted volume (see docker-compose.yml).
DATABASE_URL="file:./dev.db"

# --- File storage -------------------------------------------------------
# "local" writes to UPLOAD_DIR. Swapping to S3/GCS later means adding that
# backend in src/lib/storage.ts and changing this value — nothing else.
STORAGE_BACKEND="local"
# In Docker, put this on the same volume as the database: /data/uploads
UPLOAD_DIR="./data/uploads"

# --- Auth.js ------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL the app is reached on. Must match the redirect URI you register.
AUTH_URL="http://localhost:3000"

# --- Google sign-in (optional) ------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Microsoft / Outlook sign-in (optional) ------------------------------
# Azure Portal -> Entra ID -> App registrations -> New registration
# Redirect URI: <AUTH_URL>/api/auth/callback/microsoft-entra-id
# Issuer looks like: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
