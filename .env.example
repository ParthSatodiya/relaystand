# --- Database -----------------------------------------------------------
# Relative paths resolve from the project root, not from the schema — Prisma 7
# connects through a driver adapter, which runs in the app process. In Docker
# this is overridden to the mounted volume (see docker-compose.yml).
DATABASE_URL="file:./prisma/dev.db"

# --- Which day is "today" ------------------------------------------------
# The standard process timezone. A standup day is a calendar day, and a
# calendar day only exists relative to a zone: at 19:30 UTC it is already
# tomorrow in Kolkata. Set this to the TEAM's zone, not the server's location.
#
# Timestamps (createdAt) are UTC regardless and are not affected. This only
# decides which day new standups are filed under, and where the board's day
# boundary falls. Unset means UTC.
TZ="Europe/London"

# --- File storage -------------------------------------------------------
# "local" writes to UPLOAD_DIR. Swapping to S3/GCS later means adding that
# backend in src/lib/storage.ts and changing this value — nothing else.
STORAGE_BACKEND="local"
# In Docker, put this on the same volume as the database: /data/uploads
UPLOAD_DIR="./data/uploads"

# --- Auth.js ------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL the app is reached on. Must match the redirect URI you register.
AUTH_URL="http://localhost:3000"

# --- Who may sign in ----------------------------------------------------
# READ THIS ONE. A Google or Entra app in its usual "any account" mode will
# authenticate anybody, and anyone who signs in can create their own
# organisation on this server. Joining YOUR organisation still needs an admin's
# approval, so your data stays yours — but strangers can squat here.
#
# Either list, or both. Comma or space separated. Exact matches only:
# "acme.com" does not admit "mail.acme.com". Leave both empty and sign-in is
# open to anyone your provider lets through.
AUTH_ALLOWED_DOMAINS=""
AUTH_ALLOWED_EMAILS=""

# --- Google sign-in (optional) ------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- GitHub sign-in (optional) ------------------------------------------
# github.com -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Authorization callback URL: <AUTH_URL>/api/auth/callback/github
#
# Note: GitHub accounts usually carry a PERSONAL address, so AUTH_ALLOWED_DOMAINS
# will not match. Use AUTH_ALLOWED_EMAILS to name them, or you are letting in
# anyone with a GitHub account.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Microsoft / Outlook sign-in (optional) ------------------------------
# Azure Portal -> Entra ID -> App registrations -> New registration
# Redirect URI: <AUTH_URL>/api/auth/callback/microsoft-entra-id
# Issuer looks like: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
